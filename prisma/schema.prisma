generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  SINGLE
  AGENCY
}

enum UserRole {
  USER
  ADMIN
}

enum Plan {
  FREE
  STARTER
  GROWTH
  PRO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum SourceType {
  EDITORIAL
  CORPORATE
  UGC
  SOCIAL
  COMPETITOR
  YOU
  REFERENCE
  INSTITUTIONAL
  OTHER
}

enum SourceUrlType {
  LISTICLE
  COMPARISON
  DISCUSSION
  ARTICLE
  DOCUMENTATION
  REVIEW
  SOCIAL_POST
  HOMEPAGE
  OTHER
}

enum Engine {
  CHATGPT
  GEMINI
  PERPLEXITY
  GOOGLE_AI_OVERVIEW
  GOOGLE_AI_MODE
  COPILOT
}

enum PromptStatus {
  SUGGESTED
  ACTIVE
  INACTIVE
  ARCHIVED
  DELETED
}

enum PromptSource {
  GENERATED
  CUSTOMER
  ADMIN
}

enum VisibilityRunStatus {
  QUEUED
  RUNNING
  SUCCESS
  PARTIAL_SUCCESS
  FAILED
}

enum ScrapeJobStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  MANUAL_NEEDED
  RATE_LIMITED
}

enum BrightDataBatchStatus {
  PENDING
  TRIGGERED
  RUNNING
  SUCCESS
  PARTIAL_SUCCESS
  FAILED
  TIMED_OUT
}

enum BrightDataBatchItemStatus {
  QUEUED
  SUCCESS
  FAILED
}

enum WebAnalyticsEventType {
  PAGE_VIEW
  CUSTOM
}

enum WebAnalyticsCustomEventType {
  TOTAL_CHART
  AVERAGE_CHART
  TOTAL_LIST
  AVERAGE_LIST
}

enum SaraMessageRole {
  USER
  ASSISTANT
}

enum DemoStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model User {
  id             String      @id @default(uuid())
  email          String      @unique
  password       String
  is_verified    Boolean     @default(false)
  otp            String?
  otp_expires_at DateTime?
  account_type   AccountType
  role           UserRole    @default(USER)
  plan           Plan        @default(FREE)
  product_tour_completed Boolean @default(false)
  product_tour_completed_at DateTime?
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  projects       Project[]
  sara_conversations SaraConversation[]
  subscriptions  Subscription[]
  plan_usages    PlanUsage[]
  credit_ledger_entries CreditLedgerEntry[]
  helpcenter     HelpCenter[]
  ai_reports     AIReport[]
  content_briefs ContentBrief[]
  action_queue_items ActionQueueItem[]
  weekly_email_reports WeeklyEmailReport[]
  reddit_intelligence_runs RedditIntelligenceRun[]
  reddit_posts RedditPost[]
  brand_preferences BrandPreference[]
  billing_invoices BillingInvoice[]
}

model Project {
  id             String       @id @default(uuid())
  brand_name     String       @unique
  brand_url      String
  brand_location String
  user_id        String
  user           User         @relation(fields: [user_id], references: [id])
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  prompts        Prompt[]
  competitors    Competitor[]
  runs           Run[]
  scrape_jobs    ScrapeJob[]
  web_analytics_sites WebAnalyticsSite[]
  sara_conversations SaraConversation[]
  topics Topic[]
  ai_reports AIReport[]
  content_briefs ContentBrief[]
  action_queue_items ActionQueueItem[]
  weekly_email_reports WeeklyEmailReport[]
  reddit_intelligence_runs RedditIntelligenceRun[]
  reddit_posts RedditPost[]
  brand_preference BrandPreference?

  @@index([user_id, created_at])
}

model BrandPreference {
  id                 String   @id @default(uuid())
  project_id         String   @unique
  project            Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user_id            String
  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  industry_category  String
  buyer_persona      String?
  keywords           Json     @default("[]")
  avoid_keywords     Json     @default("[]")
  competitor_context String?
  reddit_focus       Json     @default("[]")
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@index([user_id])
  @@index([project_id, user_id])
}

model RedditIntelligenceRun {
  id              String   @id @default(uuid())
  project_id      String
  project         Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user_id         String
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  mode            String
  status          String   @default("RUNNING")
  credits_spent   Int      @default(0)
  post_limit      Int      @default(25)
  keyword_count   Int      @default(0)
  keywords        Json     @default("[]")
  summary         Json?
  themes          Json     @default("[]")
  actions         Json     @default("[]")
  raw_result      Json?
  error_reason    String?
  completed_at    DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  posts           RedditPost[]

  @@index([project_id, user_id, created_at])
  @@index([user_id, created_at])
  @@index([status, created_at])
}

model RedditPost {
  id                    String   @id @default(uuid())
  run_id                String?
  run                   RedditIntelligenceRun? @relation(fields: [run_id], references: [id], onDelete: SetNull)
  project_id            String
  project               Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user_id               String
  user                  User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post_id               String?
  url                   String
  subreddit             String?
  title                 String
  description           String?
  author                String?
  keyword               String?
  num_comments          Int      @default(0)
  num_upvotes           Int      @default(0)
  date_posted           DateTime?
  sentiment             String?
  intent                String?
  importance_score      Int      @default(0)
  mentioned_brands      Json     @default("[]")
  mentioned_competitors Json     @default("[]")
  raw_json              Json?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@unique([project_id, url])
  @@index([project_id, importance_score])
  @@index([project_id, subreddit])
  @@index([project_id, user_id, importance_score, num_comments])
  @@index([user_id, created_at])
}

model WeeklyEmailReport {
  id              String   @id @default(uuid())
  user_id         String
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  project_id      String
  project         Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  period_start    DateTime
  period_end      DateTime
  status          String
  pdf_filename    String?
  brevo_message_id String?
  error_reason    String?
  sent_at         DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([project_id, period_start, period_end])
  @@index([user_id, created_at])
  @@index([project_id, created_at])
  @@index([status, created_at])
}

model ContentBrief {
  id                 String   @id @default(uuid())
  project_id         String
  project            Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user_id            String
  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  status             String
  title              String
  slug               String?
  topic              String?
  target_prompt_id   String?
  target_prompt_text String
  content_type       String?
  action             String?
  opportunity_offset Int      @default(0)
  brief              Json
  article            Json?
  prompt_used        Json?
  generation_error   String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@unique([project_id, user_id, target_prompt_id, opportunity_offset])
  @@index([project_id, user_id, updated_at])
  @@index([user_id, updated_at])
}

model AIReport {
  id                     String   @id
  project_id             String
  project                Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user_id                String
  user                   User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  brand_name             String
  period_type            String
  period_start           DateTime
  period_end             DateTime
  previous_period_start  DateTime
  previous_period_end    DateTime
  status                 String
  summary                Json?
  report                 Json
  errors                 Json     @default("[]")
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  @@index([project_id, created_at])
  @@index([user_id, created_at])
}

model ActionQueueItem {
  id                 String   @id @default(uuid())
  project_id         String
  project            Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user_id            String
  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title              String
  description        String
  category           String
  priority           String
  status             String   @default("OPEN")
  impact_score       Int      @default(0)
  effort_score       Int      @default(0)
  confidence_score   Int      @default(0)
  recommended_action String?
  success_metric     String?
  evidence           Json     @default("{}")
  source_type        String?
  source_ref_id      String?
  due_at             DateTime?
  completed_at       DateTime?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@index([project_id, user_id, status, priority])
  @@index([project_id, user_id, updated_at])
  @@index([user_id, status])
}

model Topic {
  id         String   @id @default(uuid())
  name       String
  project_id String
  project    Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([project_id, name])
  @@index([project_id])
}
model Prompt {
  id             String       @id @default(uuid())
  text           String
  topic          String
  tags           String[]     @default([])
  type           String
  project_id     String
  project        Project      @relation(fields: [project_id], references: [id])
  is_active      Boolean      @default(true)
  status         PromptStatus @default(ACTIVE)
  source         PromptSource @default(GENERATED)
  geo_enabled    Boolean      @default(false)
  priority_score Float?
  volume_score   Float?
  last_run_at    DateTime?
  created_at     DateTime     @default(now())
  updated_at     DateTime     @default(now()) @updatedAt

  chats        Chat[]
  scrape_jobs  ScrapeJob[]
  geo_variants GeoPromptVariant[]

  @@index([project_id, is_active, status])
  @@index([project_id, created_at])
}

model GeoPromptVariant {
  id           String   @id @default(uuid())
  prompt_id    String
  prompt       Prompt   @relation(fields: [prompt_id], references: [id], onDelete: Cascade)
  country_code String   // ISO 3166-1 alpha-2, e.g. "DE", "US", "IN"
  country_name String   // "Germany", "United States"
  city         String?  // Optional: "Munich", "Berlin"
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())

  scrape_jobs ScrapeJob[]
  chats       Chat[]

  @@unique([prompt_id, country_code, city])
  @@index([prompt_id])
}

model Competitor {
  id         String   @id @default(uuid())
  name       String
  url        String?
  project_id String
  project    Project  @relation(fields: [project_id], references: [id])
  created_at DateTime @default(now())

  @@index([project_id, created_at])
}

model Run {
  id         String   @id @default(uuid())
  project_id String
  project    Project  @relation(fields: [project_id], references: [id])
  status     VisibilityRunStatus @default(QUEUED)
  scheduled_for DateTime?
  started_at DateTime?
  completed_at DateTime?
  error_reason String?
  ran_at     DateTime @default(now())

  chats      Chat[]
  scrape_jobs ScrapeJob[]

  @@index([project_id, ran_at])
  @@index([status, scheduled_for])
}

model Chat {
  id               String    @id @default(uuid())
  run_id           String
  run              Run       @relation(fields: [run_id], references: [id])
  prompt_id        String
  prompt           Prompt    @relation(fields: [prompt_id], references: [id])
  geo_variant_id   String?
  geo_variant      GeoPromptVariant? @relation(fields: [geo_variant_id], references: [id])
  geo_country_code String?   // "DE"
  geo_country_name String?   // "Germany"
  geo_city         String?   // "Munich"
  ai_model         String
  raw_response     String
  display_response  String?   // cleaned/formatted version for UI display
  answer_blocks    Json?
  screenshot_path  String?
  brand_mentioned  Boolean
  brand_position   Int?
  sentiment_score  Float?
  created_at       DateTime  @default(now())

  brand_mentions BrandMention[]
  sources        Source[]
  scrape_job     ScrapeJob?

  @@index([run_id, created_at])
  @@index([prompt_id, created_at])
  @@index([prompt_id, brand_mentioned, created_at])
  @@index([prompt_id, geo_country_code, created_at])
  @@index([prompt_id, ai_model, created_at])
  @@index([ai_model, created_at])
}

model ScrapeJob {
  id               String           @id @default(uuid())
  run_id           String
  run              Run              @relation(fields: [run_id], references: [id])
  project_id       String
  project          Project          @relation(fields: [project_id], references: [id])
  prompt_id        String
  prompt           Prompt           @relation(fields: [prompt_id], references: [id])
  geo_variant_id   String?
  geo_variant      GeoPromptVariant? @relation(fields: [geo_variant_id], references: [id])
  geo_country_code String?
  geo_country_name String?
  geo_city         String?
  chat_id          String?          @unique
  chat             Chat?            @relation(fields: [chat_id], references: [id])
  engine           Engine
  status           ScrapeJobStatus  @default(QUEUED)
  profile          String?
  answer_text      String?
  raw_text         String?
  citations        Json?
  screenshot_path  String?
  retry_count      Int              @default(0)
  error_reason     String?
  scheduled_for    DateTime?
  started_at       DateTime?
  completed_at     DateTime?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt

  bright_data_batch_item BrightDataBatchItem?

  @@index([run_id, status])
  @@index([project_id, status, created_at])
  @@index([status, scheduled_for])
}

model BrightDataBatch {
  id              String                @id @default(uuid())
  engine          Engine
  geo_country_code String?
  scraper_id      String
  snapshot_id     String?               @unique
  status          BrightDataBatchStatus @default(PENDING)
  input_count     Int
  completed_count Int                   @default(0)
  failed_count    Int                   @default(0)
  error_reason    String?
  triggered_at    DateTime?
  last_polled_at  DateTime?
  next_poll_at    DateTime?
  completed_at    DateTime?
  created_at      DateTime              @default(now())
  updated_at      DateTime              @updatedAt

  items           BrightDataBatchItem[]

  @@index([status, next_poll_at])
  @@index([engine, geo_country_code, created_at])
}

model BrightDataBatchItem {
  id            String                    @id @default(uuid())
  batch_id      String
  batch         BrightDataBatch           @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  scrape_job_id String                    @unique
  scrape_job    ScrapeJob                 @relation(fields: [scrape_job_id], references: [id], onDelete: Cascade)
  input_index   Int
  status        BrightDataBatchItemStatus @default(QUEUED)
  error_reason  String?
  created_at    DateTime                  @default(now())
  updated_at    DateTime                  @updatedAt

  @@unique([batch_id, input_index])
  @@index([batch_id, status])
}

model BrandMention {
  id              String   @id @default(uuid())
  chat_id         String
  chat            Chat     @relation(fields: [chat_id], references: [id])
  brand_name      String
  domain          String?  // e.g. peec.ai, profound.ai
  position        Int?
  sentiment_score Float?
  created_at      DateTime @default(now())

  @@index([chat_id])
  @@index([brand_name, chat_id])
  @@index([chat_id, brand_name])
}

model Source {
  id                    String            @id @default(uuid())
  chat_id               String
  chat                  Chat              @relation(fields: [chat_id], references: [id])
  source_url_content_id String?
  source_url_content    SourceUrlContent? @relation(fields: [source_url_content_id], references: [id])
  url                   String
  domain                String
  source_type           SourceType        @default(OTHER)
  url_type              SourceUrlType     @default(OTHER)
  is_cited              Boolean           @default(false)
  used_by_ai            Boolean           @default(true)
  title                 String?
  snippet               String?
  platform              String?
  subreddit             String?
  mentioned_brands      Json?
  created_at            DateTime          @default(now())
  updated_at            DateTime          @default(now()) @updatedAt

  @@index([chat_id, domain])
  @@index([chat_id, is_cited])
  @@index([chat_id, created_at])
  @@index([domain, created_at])
  @@index([source_url_content_id])
}

model SourceUrlContent {
  id                 String        @id @default(uuid())
  url                String        @unique
  domain             String
  title              String?
  content            String?
  snippet            String?
  content_length     Int           @default(0)
  source_type        SourceType    @default(OTHER)
  url_type           SourceUrlType @default(OTHER)
  platform           String?
  subreddit          String?
  mentioned_brands   Json?
  fetch_status       String        @default("PENDING")
  error_reason       String?
  content_updated_at DateTime?
  created_at         DateTime      @default(now())
  updated_at         DateTime      @default(now()) @updatedAt

  sources            Source[]

  @@index([domain, fetch_status])
  @@index([updated_at])
}

model WebAnalyticsSite {
  id         String   @id @default(uuid())
  project_id String
  project    Project  @relation(fields: [project_id], references: [id])
  name       String
  domain     String
  public_key String   @unique
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  sessions   WebAnalyticsSession[]
  events     WebAnalyticsEvent[]
  custom_events WebAnalyticsCustomEvent[]

  @@index([project_id])
  @@index([public_key])
}

model WebAnalyticsSession {
  id           String   @id @default(uuid())
  site_id      String
  site         WebAnalyticsSite @relation(fields: [site_id], references: [id])
  visitor_id   String
  ip_hash      String?
  user_agent   String?
  browser      String?
  browser_version String?
  browser_width Int?
  browser_height Int?
  os           String?
  os_version   String?
  device       String?
  language     String?
  screen_width Int?
  screen_height Int?
  screen_color_depth Int?
  country      String?
  referrer     String?
  source       String?
  medium       String?
  landing_page String?
  started_at   DateTime @default(now())
  last_seen_at DateTime @default(now())

  events       WebAnalyticsEvent[]
  actions      WebAnalyticsAction[]

  @@unique([site_id, visitor_id])
  @@index([site_id, last_seen_at])
}

model WebAnalyticsEvent {
  id          String   @id @default(uuid())
  site_id     String
  site        WebAnalyticsSite @relation(fields: [site_id], references: [id])
  session_id  String?
  session     WebAnalyticsSession? @relation(fields: [session_id], references: [id])
  type        WebAnalyticsEventType @default(PAGE_VIEW)
  path        String
  url         String?
  title       String?
  referrer    String?
  event_name  String?
  event_value Json?
  duration_ms Int?
  metadata    Json?
  created_at  DateTime @default(now())

  @@index([site_id, created_at])
  @@index([site_id, type, created_at])
  @@index([session_id])
}

model WebAnalyticsCustomEvent {
  id         String   @id @default(uuid())
  site_id    String
  site       WebAnalyticsSite @relation(fields: [site_id], references: [id])
  title      String
  type       WebAnalyticsCustomEventType @default(TOTAL_CHART)
  key        String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  actions    WebAnalyticsAction[]

  @@index([site_id])
}

model WebAnalyticsAction {
  id              String   @id @default(uuid())
  custom_event_id String
  custom_event    WebAnalyticsCustomEvent @relation(fields: [custom_event_id], references: [id])
  session_id       String?
  session          WebAnalyticsSession? @relation(fields: [session_id], references: [id])
  key              String?
  value            Float   @default(1)
  details          String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([custom_event_id, created_at])
  @@index([session_id])
}

model SaraConversation {
  id         String   @id @default(uuid())
  project_id String
  project    Project  @relation(fields: [project_id], references: [id])
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  title      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  messages   SaraMessage[]

  @@index([project_id, updated_at])
  @@index([user_id, updated_at])
}

model SaraMessage {
  id              String          @id @default(uuid())
  conversation_id String
  conversation    SaraConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  role            SaraMessageRole
  content         String
  citations       Json?
  suggested_actions String[] @default([])
  retrieved_context Json?
  confidence      String?
  created_at      DateTime @default(now())

  @@index([conversation_id, created_at])
}

model Subscription {
  id                     String             @id @default(uuid())
  user_id                String
  user                   User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  plan                   Plan
  status                 SubscriptionStatus @default(TRIALING)
  amount_cents           Int
  currency               String             @default("usd")
  current_period_start   DateTime?
  current_period_end     DateTime?
  cancel_at_period_end   Boolean            @default(false)
  stripe_customer_id     String?
  stripe_subscription_id String?            @unique
  stripe_checkout_session_id String?        @unique
  billing_interval       String             @default("monthly")
  trial_starts_at        DateTime           @default(now())
  trial_ends_at          DateTime?
  created_at             DateTime           @default(now())
  updated_at             DateTime           @updatedAt

  billing_invoices       BillingInvoice[]

  @@index([user_id, status])
  @@index([user_id, plan])
}

model StripeWebhookEvent {
  id              String   @id @default(uuid())
  stripe_event_id String   @unique
  event_type      String
  status          String   @default("PROCESSING")
  error_reason    String?
  processed_at    DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([status, created_at])
}

model BillingInvoice {
  id                        String        @id @default(uuid())
  user_id                   String
  user                      User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  subscription_id           String?
  subscription              Subscription? @relation(fields: [subscription_id], references: [id], onDelete: SetNull)
  stripe_invoice_id         String        @unique
  stripe_subscription_id    String?
  invoice_number            String?
  status                    String
  billing_reason            String?
  currency                  String
  amount_due                Int
  amount_paid               Int
  amount_remaining          Int
  period_start              DateTime?
  period_end                DateTime?
  hosted_invoice_url        String?
  invoice_pdf_url           String?
  payment_email_sent_at     DateTime?
  payment_email_message_id  String?
  failure_email_sent_at     DateTime?
  failure_email_message_id  String?
  email_error               String?
  paid_at                   DateTime?
  created_at                DateTime      @default(now())
  updated_at                DateTime      @updatedAt

  @@index([user_id, created_at])
  @@index([stripe_subscription_id])
  @@index([status, created_at])
}

model PlanUsage {
  id                  String   @id @default(uuid())
  user_id             String
  user                User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  prompt_count        Int      @default(0)
  project_count       Int      @default(0)
  competitor_count    Int      @default(0)
  monthly_runs_used   Int      @default(0)
  period_start        DateTime
  period_end          DateTime
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@unique([user_id, period_start, period_end])
  @@index([user_id, period_start, period_end])
}

model CreditLedgerEntry {
  id              String   @id @default(uuid())
  user_id         String
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  amount          Int
  action          String
  description     String?
  idempotency_key String   @unique
  metadata        Json?
  period_start    DateTime
  period_end      DateTime
  created_at      DateTime @default(now())

  @@index([user_id, period_start, period_end])
  @@index([user_id, action, created_at])
}

model HelpCenter {
  id          String   @id @default(uuid())
  email       String
  subject     String
  message     String

  user_id     String
  user        User     @relation(fields: [user_id], references: [id])

  is_resolved Boolean  @default(false)

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([user_id])
  @@index([is_resolved])
}


model BookDemo {
  id          String     @id @default(uuid())

  name        String
  email       String
  company     String?
  notes       String?

  scheduledAt DateTime
  timezone    String
  countryCode String?
  countryName String?
  localTimeLabel String?
  istTimeLabel   String?

  status      DemoStatus @default(PENDING)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([scheduledAt])
}

model PublicChatLead {
  id          String   @id @default(uuid())
  name        String?
  email       String?
  company     String?
  message     String
  topic       String?
  page_path   String?
  user_agent  String?
  ip_hash     String?
  created_at  DateTime @default(now())

  @@index([email, created_at])
  @@index([topic, created_at])
  @@index([created_at])
}
