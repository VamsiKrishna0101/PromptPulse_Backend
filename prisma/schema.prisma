  @@index([status, created_at])
}

// ═══════════════════════════════════════════════════════════════════════════════
// SEO V2 Models
// ═══════════════════════════════════════════════════════════════════════════════

model SeoCrawlJob {
  id                 String         @id @default(uuid())
  project_id         String
  project            Project        @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user_id            String
  user               User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  url                String
  mode               String         @default("STANDARD") // QUICK | STANDARD | DEEP
  max_pages          Int            @default(100)
  status             SeoV2JobStatus @default(QUEUED)
  pages_crawled      Int            @default(0)
  pages_queued       Int            @default(0)
  pages_failed       Int            @default(0)
  crawl_coverage     Float?
  credits_reserved   Int            @default(0)
  credits_spent      Int            @default(0)
  error_reason       String?
  partial_reason     String?
  robots_txt_url     String?
  robots_txt_raw     String?
  sitemap_urls_found Int            @default(0)
  started_at         DateTime?
  completed_at       DateTime?
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt

  audit SeoV2Audit?

  @@index([project_id, created_at])
  @@index([user_id, created_at])
  @@index([status, created_at])
}

model SeoV2Audit {
  id              String      @id @default(uuid())
  crawl_job_id    String      @unique
  crawl_job       SeoCrawlJob @relation(fields: [crawl_job_id], references: [id], onDelete: Cascade)
  project_id      String
  project         Project     @relation(fields: [project_id], references: [id], onDelete: Cascade)
  url             String
  is_partial      Boolean     @default(false)
  crawl_coverage  Float       @default(0)
  pages_crawled   Int         @default(0)
  pages_failed    Int         @default(0)
  issues_count    Int         @default(0)
  critical_count  Int         @default(0)
  high_count      Int         @default(0)
  medium_count    Int         @default(0)
  low_count       Int         @default(0)
  technical_score Int?
  confidence      Float       @default(0)
  compared_to_id  String? // previous audit id for diff
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  pages  SeoV2Page[]
  issues SeoV2Issue[]

  @@index([project_id, created_at])
}

model SeoV2Page {
  id                  String              @id @default(uuid())
  audit_id            String
  audit               SeoV2Audit          @relation(fields: [audit_id], references: [id], onDelete: Cascade)
  url                 String
  canonical_url       String?
  status_code         Int?
  error_code          SeoV2CrawlErrorCode @default(NONE)
  redirect_chain      Json                @default("[]")
  crawl_depth         Int                 @default(0)
  inbound_links_count Int                 @default(0)
  is_orphan           Boolean             @default(false)
  indexable           Boolean             @default(true)
  robots_blocked      Boolean             @default(false)
  noindex             Boolean             @default(false)
  canonical_is_self   Boolean             @default(true)
  title               String?
  title_length        Int?
  meta_description    String?
  meta_desc_length    Int?
  h1                  String?
  h1_count            Int                 @default(0)
  h2_count            Int                 @default(0)
  word_count          Int                 @default(0)
  content_hash        String?
  has_viewport        Boolean             @default(false)
  has_schema          Boolean             @default(false)
  schema_types        String[]            @default([])
  images_total        Int                 @default(0)
  images_missing_alt  Int                 @default(0)
  internal_links      Int                 @default(0)
  external_links      Int                 @default(0)
  page_size_bytes     Int?
  response_time_ms    Int?
  created_at          DateTime            @default(now())

  issues SeoV2Issue[]

  @@index([audit_id])
  @@index([audit_id, status_code])
  @@index([audit_id, indexable])
  @@index([url])
}

model SeoV2Issue {
  id                   String                 @id @default(uuid())
  audit_id             String
  audit                SeoV2Audit             @relation(fields: [audit_id], references: [id], onDelete: Cascade)
  page_id              String?
  page                 SeoV2Page?             @relation(fields: [page_id], references: [id], onDelete: SetNull)
  category             SeoV2IssueCategory
  severity             SeoV2IssueSeverity
  title                String
  description          String
  evidence             String
  why_it_matters       String
  recommended_fix      String
  affected_pages_count Int                    @default(1)
  example_urls         String[]               @default([])
  priority_score       Int                    @default(50)
  verification         SeoV2IssueVerification @default(UNVERIFIED)
  verified_at          DateTime?
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt

  @@index([audit_id, category])
  @@index([audit_id, severity])
  @@index([page_id])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Phase 2: Google Search Console
// ═══════════════════════════════════════════════════════════════════════════════

model GscConnection {
  id                  String    @id @default(uuid())
  project_id          String
  project             Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user_id             String
  user                User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  access_token        String
  refresh_token       String
  token_expires_at    DateTime
  scope               String
  selected_site_url   String?
  selected_at         DateTime?
  last_synced_at      DateTime?
  data_freshness_date DateTime?
  disconnected_at     DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  data_rows GscDataRow[]

  @@unique([project_id, user_id])
  @@index([project_id, user_id])
  @@index([user_id, disconnected_at])
}

model GscDataRow {
  id            String        @id @default(uuid())
  project_id    String
  project       Project       @relation(fields: [project_id], references: [id], onDelete: Cascade)
  connection_id String
  connection    GscConnection @relation(fields: [connection_id], references: [id], onDelete: Cascade)
  query         String
  page          String
  date          DateTime
  country       String        @default("")
  device        String        @default("")
  clicks        Int           @default(0)
  impressions   Int           @default(0)
  ctr           Float         @default(0)
  position      Float         @default(0)
  updated_at    DateTime      @default(now()) @updatedAt

  @@unique([project_id, query, page, date, country, device])
  @@index([project_id, date])
  @@index([project_id, query, date])
  @@index([project_id, page, date])
  @@index([connection_id, date])
}

// ─── WhatsApp Campaigns ───────────────────────────────────────────────────────

enum WhatsAppCampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  PAUSED
  FAILED
}

enum WhatsAppTemplateStatus {
  APPROVED
  PENDING
  REJECTED
  PAUSED
  DISABLED
}

enum WhatsAppTemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum WhatsAppRecipientStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum WhatsAppQualityRating {
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

model WhatsAppAccount {
  id                   String                @id @default(uuid())
  user_id              String
  project_id           String                @unique
  waba_id              String
  phone_number_id      String                @unique
  display_phone        String
  display_name         String
  access_token         String                // Encrypted Meta System User Token
  quality_rating       WhatsAppQualityRating @default(UNKNOWN)
  messaging_limit      Int                   @default(1000)
  profile_pic_url      String?
  profile_pic_handle   String?
  about                String?
  business_category    String?
  business_description String?
  website              String?
  address              String?
  is_green_badge       Boolean               @default(false)
  created_at           DateTime              @default(now())
  updated_at           DateTime              @updatedAt

  user      User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  campaigns  WhatsAppCampaign[]
  templates  WhatsAppTemplate[]
  bot_config WhatsAppBotConfig?
  leads      WhatsAppAppointmentLead[]

  @@index([user_id])
}

model WhatsAppTemplate {
  id          String                   @id @default(uuid())
  account_id  String
  meta_id     String?                  // Meta's template ID after creation
  name        String
  language    String                   @default("en")
  category    WhatsAppTemplateCategory @default(MARKETING)
  status      WhatsAppTemplateStatus   @default(PENDING)
  components  Json                     // Full Meta template component schema
  created_at  DateTime                 @default(now())
  updated_at  DateTime                 @updatedAt

  account   WhatsAppAccount    @relation(fields: [account_id], references: [id], onDelete: Cascade)
  campaigns WhatsAppCampaign[]

  @@unique([account_id, name, language])
  @@index([account_id, status])
}

model WhatsAppCampaign {
  id                  String                    @id @default(uuid())
  account_id          String
  user_id             String
  name                String
  objective           String?                   // e.g. "Promotion", "Product Update"
  status              WhatsAppCampaignStatus    @default(DRAFT)
  template_id         String?
  header_media_url    String?
  header_media_type   String?                   // "IMAGE" | "DOCUMENT" | "VIDEO"
  variable_mapping    Json?                     // CSV col -> template var mapping
  total_recipients    Int                       @default(0)
  sent_count          Int                       @default(0)
  delivered_count     Int                       @default(0)
  read_count          Int                       @default(0)
  failed_count        Int                       @default(0)
  estimated_cost_inr  Decimal?                  @db.Decimal(12, 2)
  pace_per_second     Int                       @default(10)
  scheduled_at        DateTime?
  started_at          DateTime?
  completed_at        DateTime?
  error_message       String?
  created_at          DateTime                  @default(now())
  updated_at          DateTime                  @updatedAt

  account    WhatsAppAccount              @relation(fields: [account_id], references: [id], onDelete: Cascade)
  template   WhatsAppTemplate?            @relation(fields: [template_id], references: [id], onDelete: SetNull)
  recipients WhatsAppCampaignRecipient[]

  @@index([account_id, status])
  @@index([user_id, created_at])
}

model WhatsAppCampaignRecipient {
  id           String                  @id @default(uuid())
  campaign_id  String
  phone        String                  // "+91XXXXXXXXXX"
  name         String?
  variables    Json?                   // Template variable values for this recipient
  status       WhatsAppRecipientStatus @default(QUEUED)
  meta_msg_id  String?                 // wamid from Meta API response
  error_code   String?
  error_msg    String?
  sent_at      DateTime?
  delivered_at DateTime?
  read_at      DateTime?
  created_at   DateTime                @default(now())

  campaign WhatsAppCampaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@index([campaign_id, status])
  @@index([campaign_id, phone])
  @@index([meta_msg_id])
}

enum LeadStatus {
  PENDING_CALL
  CALLED
  APPOINTMENT_CONFIRMED
  NOT_INTERESTED
  CANCELLED
}

model WhatsAppBotConfig {
  id                   String   @id @default(uuid())
  account_id           String   @unique
  is_enabled           Boolean  @default(true)
  business_name        String   @default("City Care Hospital")
  business_type        String   @default("HOSPITAL")
  greeting_message     String   @default("Namaste! Welcome to {business_name}. How can we assist you today?")
  services_catalog     Json     // [{ id, name, desc, fee, doctors: [{ id, name, title, timing, fee }] }]
  faq_knowledge_base   Json     // [{ question, answer, category }]
  required_fields      Json     // ["name", "phone", "service", "doctor", "slot", "notes"]
  escalation_phones    String[] // Staff phone numbers for instant WhatsApp alert
  escalation_message   String?
  confirmation_message String?
  ai_fallback_enabled  Boolean  @default(true)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  account WhatsAppAccount @relation(fields: [account_id], references: [id], onDelete: Cascade)
}

model WhatsAppAppointmentLead {
  id                 String     @id @default(uuid())
  account_id         String
  patient_name       String
  patient_phone      String
  service_requested  String
  doctor_requested   String?
  preferred_time     String?
  symptoms           String?
  status             LeadStatus @default(PENDING_CALL)
  escalated_to_phone String?
  staff_notes        String?
  created_at         DateTime   @default(now())
  updated_at         DateTime   @updatedAt

  account WhatsAppAccount @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@index([account_id, status])
  @@index([account_id, created_at])
}

// ─────────────────────────────────────────────────────────────────────────────
// Voice AI Campaigns (Indian Telephony & Healthcare/Business Playbooks)
// ─────────────────────────────────────────────────────────────────────────────

enum VoicePlaybookType {
  OPD_APPOINTMENT_CONFIRMATION
  POST_DISCHARGE_CARE
  LAB_REPORT_ALERT
  PREVENTIVE_HEALTH_CAMP
  CUSTOM_OUTREACH
}

enum VoiceCallStatus {
  QUEUED
  RINGING
  IN_PROGRESS
  COMPLETED
  BUSY
  NO_ANSWER
  FAILED
}

enum VoiceOutcomeIntent {
  CONFIRMED
  RESCHEDULED
  CANCELLED
  URGENT_EMERGENCY_ESCALATION
  CALLBACK_REQUESTED
  NOT_INTERESTED
  UNKNOWN
}

model VoiceAccount {
  id              String   @id @default(uuid())
  project_id      String   @unique
  user_id         String
  provider        String   @default("AZURE_EXOTEL") // AZURE_EXOTEL | PLIVO | TATA | SIMULATOR
  caller_id       String   @default("+918045678900")
  azure_speech_key String?
  azure_region    String?  @default("centralindia")
  exotel_sid      String?
  exotel_token    String?
  is_verified     Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user            User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  project         Project            @relation(fields: [project_id], references: [id], onDelete: Cascade)
  campaigns       VoiceCampaign[]
  agents          VoiceAgentConfig[]

  @@index([user_id])
}

model VoiceAgentConfig {
  id                   String            @id @default(uuid())
  account_id           String
  name                 String            @default("Telugu Receptionist (Shruti)")
  playbook_type        VoicePlaybookType @default(OPD_APPOINTMENT_CONFIRMATION)
  language             String            @default("te-IN") // te-IN, hi-IN, en-IN
  voice_name           String            @default("te-IN-ShrutiNeural") // Azure Telugu Voice
  system_prompt        String            @db.Text
  emergency_keywords   String[]          @default(["chest pain", "fever", "emergency", "severe pain", "bleeding", "doctor"])
  live_transfer_number String?           // e.g. "+919876543210"
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt

  account              VoiceAccount      @relation(fields: [account_id], references: [id], onDelete: Cascade)
  campaigns            VoiceCampaign[]

  @@index([account_id])
}

model VoiceCampaign {
  id                String            @id @default(uuid())
  account_id        String
  agent_id          String
  name              String
  playbook_type     VoicePlaybookType @default(OPD_APPOINTMENT_CONFIRMATION)
  status            String            @default("DRAFT") // DRAFT | QUEUED | IN_PROGRESS | PAUSED_TIME_WINDOW | COMPLETED
  total_recipients  Int               @default(0)
  called_count      Int               @default(0)
  confirmed_count   Int               @default(0)
  rescheduled_count Int               @default(0)
  cancelled_count   Int               @default(0)
  urgent_count      Int               @default(0)
  failed_count      Int               @default(0)
  concurrent_limit  Int               @default(10)      // Max 10-12 concurrent lines
  scheduled_at      DateTime?
  started_at        DateTime?
  completed_at      DateTime?
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt

  account           VoiceAccount      @relation(fields: [account_id], references: [id], onDelete: Cascade)
  agent             VoiceAgentConfig  @relation(fields: [agent_id], references: [id], onDelete: Cascade)
  records           VoiceCallRecord[]

  @@index([account_id, status])
}

model VoiceCallRecord {
  id               String             @id @default(uuid())
  campaign_id      String
  patient_name     String
  patient_phone    String
  doctor_name      String?
  scheduled_slot   String?
  status           VoiceCallStatus    @default(QUEUED)
  outcome_intent   VoiceOutcomeIntent @default(UNKNOWN)
  duration_seconds Int                @default(0)
  ai_summary       String?            @db.Text
  transcript       Json?              // [{ sender: "ai"|"user", text: "...", time: "..." }]
  recording_url    String?
  is_urgent        Boolean            @default(false)
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt

  campaign         VoiceCampaign      @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@index([campaign_id, status])
  @@index([campaign_id, outcome_intent])
}

// ─────────────────────────────────────────────────────────────────────────────
// Email Campaigns (AWS SES / Brevo)
// ─────────────────────────────────────────────────────────────────────────────

enum EmailCampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  PAUSED
  FAILED
}

enum EmailRecipientStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  COMPLAINT
  OPENED
  CLICKED
  FAILED
}

model EmailAccount {
  id              String   @id @default(uuid())
  project_id      String   @unique
  user_id         String
  provider        String   @default("AWS_SES") // AWS_SES | BREVO
  from_name       String
  from_email      String
  reply_to_email  String?
  is_verified     Boolean  @default(false)
  aws_region      String?  @default("ap-south-1")
  aws_access_key  String?
  aws_secret_key  String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user            User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  project         Project         @relation(fields: [project_id], references: [id], onDelete: Cascade)
  campaigns       EmailCampaign[]
  templates       EmailTemplate[]

  @@index([user_id])
}

model EmailTemplate {
  id          String   @id @default(uuid())
  account_id  String
  name        String
  subject     String
  html_body   String   @db.Text
  design_json Json?    // To store drag-and-drop editor state if needed
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  account   EmailAccount    @relation(fields: [account_id], references: [id], onDelete: Cascade)
  campaigns EmailCampaign[]

  @@unique([account_id, name])
}

model EmailCampaign {
  id                 String              @id @default(uuid())
  account_id         String
  user_id            String
  name               String
  status             EmailCampaignStatus @default(DRAFT)
  template_id        String?
  total_recipients   Int                 @default(0)
  sent_count         Int                 @default(0)
  delivered_count    Int                 @default(0)
  opened_count       Int                 @default(0)
  clicked_count      Int                 @default(0)
  bounced_count      Int                 @default(0)
  complaint_count    Int                 @default(0)
  failed_count       Int                 @default(0)
  scheduled_at       DateTime?
  started_at         DateTime?
  completed_at       DateTime?
  error_message      String?
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt

  account    EmailAccount             @relation(fields: [account_id], references: [id], onDelete: Cascade)
  template   EmailTemplate?           @relation(fields: [template_id], references: [id], onDelete: SetNull)
  recipients EmailCampaignRecipient[]

  @@index([account_id, status])
  @@index([user_id, created_at])
}

model EmailCampaignRecipient {
  id           String               @id @default(uuid())
  campaign_id  String
  email        String
  name         String?
  variables    Json?                // Template variable values for this recipient
  status       EmailRecipientStatus @default(QUEUED)
  message_id   String?              // Message ID from provider
  error_msg    String?
  sent_at      DateTime?
  delivered_at DateTime?
  opened_at    DateTime?
  clicked_at   DateTime?
  created_at   DateTime             @default(now())

  campaign EmailCampaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@index([campaign_id, status])
  @@index([campaign_id, email])
  @@index([message_id])
}
