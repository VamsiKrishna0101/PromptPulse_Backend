generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  SINGLE
  AGENCY
}

enum UserRole {
  USER
  ADMIN
}

enum AgencyMembershipRole {
  OWNER
  ADMIN
  MANAGER
  ANALYST
  CLIENT_ADMIN
  CLIENT_VIEWER
}

enum AgencyMembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum AgencyInvitationType {
  TEAM_MEMBER
  CLIENT_USER
}

enum AgencyInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum Plan {
  FREE
  STARTER
  GROWTH
  PRO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum SourceType {
  EDITORIAL
  CORPORATE
  UGC
  SOCIAL
  COMPETITOR
  YOU
  REFERENCE
  INSTITUTIONAL
  OTHER
}

enum SourceUrlType {
  LISTICLE
  COMPARISON
  DISCUSSION
  ARTICLE
  DOCUMENTATION
  REVIEW
  SOCIAL_POST
  HOMEPAGE
  OTHER
}

enum Engine {
  CHATGPT
  GEMINI
  PERPLEXITY
  GOOGLE_AI_OVERVIEW
  GOOGLE_AI_MODE
  COPILOT
}

enum PromptStatus {
  SUGGESTED
  ACTIVE
  INACTIVE
  ARCHIVED
  DELETED
}

enum PromptSource {
  GENERATED
  CUSTOMER
  ADMIN
}

enum VisibilityRunStatus {
  QUEUED
  RUNNING
  SUCCESS
  PARTIAL_SUCCESS
  FAILED
}

enum ScrapeJobStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  MANUAL_NEEDED
  RATE_LIMITED
}

enum BrightDataBatchStatus {
  PENDING
  TRIGGERED
  RUNNING
  SUCCESS
  PARTIAL_SUCCESS
  FAILED
  TIMED_OUT
}

enum BrightDataBatchItemStatus {
  QUEUED
  SUCCESS
  FAILED
}

enum WebAnalyticsEventType {
  PAGE_VIEW
  CUSTOM
}

enum WebAnalyticsCustomEventType {
  TOTAL_CHART
  AVERAGE_CHART
  TOTAL_LIST
  AVERAGE_LIST
}

enum SaraMessageRole {
  USER
  ASSISTANT
}

enum DemoStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ─── SEO V2 Enums ─────────────────────────────────────────────────────────────

enum SeoV2JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum SeoV2CrawlErrorCode {
  NONE
  DNS_FAILURE
  TIMEOUT
  ROBOTS_BLOCKED
  HTTP_403
  HTTP_404
  HTTP_4XX
  HTTP_500
  HTTP_5XX
  REDIRECT_LOOP
  PARSE_ERROR
}

enum SeoV2IssueSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum SeoV2IssueCategory {
  INDEXABILITY
  REDIRECT
  CANONICAL
  TITLE
  META_DESCRIPTION
  HEADINGS
  IMAGES
  LINKS
  SCHEMA
  MOBILE
  DUPLICATE_CONTENT
  SITEMAP
  ROBOTS
  ORPHAN_PAGES
  CRAWL_DEPTH
}

enum SeoV2IssueVerification {
  UNVERIFIED
  PENDING_RECRAWL
  VERIFIED_FIXED
  VERIFIED_STILL_PRESENT
}

model User {
  id                        String      @id @default(uuid())
  email                     String      @unique
  password                  String
  is_verified               Boolean     @default(false)
  otp                       String?
  otp_expires_at            DateTime?
  account_type              AccountType
  role                      UserRole    @default(USER)
  plan                      Plan        @default(FREE)
  credits_balance           Int         @default(0)
  product_tour_completed    Boolean     @default(false)
  product_tour_completed_at DateTime?
  created_at                DateTime    @default(now())
  updated_at                DateTime    @updatedAt

  projects                         Project[]
  sara_conversations               SaraConversation[]
  subscriptions                    Subscription[]
  plan_usages                      PlanUsage[]
  credit_ledger_entries            CreditLedgerEntry[]
  helpcenter                       HelpCenter[]
  ai_reports                       AIReport[]
  content_briefs                   ContentBrief[]
  action_queue_items               ActionQueueItem[]
  weekly_email_reports             WeeklyEmailReport[]
  reddit_intelligence_runs         RedditIntelligenceRun[]
  seo_audits                       SeoAudit[]
  reddit_posts                     RedditPost[]
  brand_preferences                BrandPreference[]
  billing_invoices                 BillingInvoice[]
  credit_transactions              CreditTransaction[]
  razorpay_orders                  RazorpayOrder[]
  credit_buckets                   CreditBucket[]
  owned_agency_memberships         AgencyMembership[]                    @relation("AgencyOwnerMemberships")
  agency_memberships               AgencyMembership[]                    @relation("AgencyMemberMemberships")
  sent_agency_invitations          AgencyInvitation[]                    @relation("AgencyInvitationOwner")
  received_agency_invitations      AgencyInvitation[]                    @relation("AgencyInvitationInvitee")
  agency_client_links              AgencyClientLink[]                    @relation("AgencyClientOwner")
  client_agency_links              AgencyClientLink[]                    @relation("AgencyClientUser")
  agency_branding                  AgencyBranding?
  agency_portal_shares             AgencyPortalShare[]                   @relation("AgencyPortalShares")
  // SEO V2
  seo_crawl_jobs                   SeoCrawlJob[]
  gsc_connections                  GscConnection[]
  seo_domain_overview_snapshots    SeoDomainResearchOverviewSnapshot[]
  seo_domain_keyword_snapshots     SeoDomainResearchKeywordSnapshot[]
  seo_domain_top_pages_snapshots   SeoDomainResearchTopPagesSnapshot[]
  seo_domain_competitor_snapshots  SeoDomainResearchCompetitorSnapshot[]
  seo_domain_keyword_gap_snapshots SeoDomainResearchKeywordGapSnapshot[]
  seo_provider_snapshots           SeoProviderSnapshot[]
  seo_onboarding_runs              SeoOnboardingRun[]     @relation("SeoOnboardingClient")
  seo_onboarding_runs_requested    SeoOnboardingRun[]     @relation("SeoOnboardingRequestedBy")
  // Campaigns
  whatsapp_accounts                WhatsAppAccount[]
  voice_accounts                   VoiceAccount[]
  email_accounts                   EmailAccount[]
}

model AgencyMembership {
  id             String                 @id @default(uuid())
  agency_user_id String
  member_user_id String
  role           AgencyMembershipRole   @default(ANALYST)
  status         AgencyMembershipStatus @default(ACTIVE)
  created_at     DateTime               @default(now())
  updated_at     DateTime               @updatedAt

  agency User @relation("AgencyOwnerMemberships", fields: [agency_user_id], references: [id], onDelete: Cascade)
  member User @relation("AgencyMemberMemberships", fields: [member_user_id], references: [id], onDelete: Cascade)

  @@unique([agency_user_id, member_user_id])
  @@index([member_user_id, status])
  @@index([agency_user_id, status])
}

model AgencyInvitation {
  id              String                 @id @default(uuid())
  agency_user_id  String
  invitee_user_id String?
  email           String
  type            AgencyInvitationType   @default(TEAM_MEMBER)
  role            AgencyMembershipRole   @default(ANALYST)
  token           String                 @unique
  status          AgencyInvitationStatus @default(PENDING)
  assigned_project_ids String[]          @default([])
  expires_at      DateTime
  created_at      DateTime               @default(now())
  updated_at      DateTime               @updatedAt

  agency  User  @relation("AgencyInvitationOwner", fields: [agency_user_id], references: [id], onDelete: Cascade)
  invitee User? @relation("AgencyInvitationInvitee", fields: [invitee_user_id], references: [id], onDelete: SetNull)

  @@index([email, status])
  @@index([agency_user_id, status])
}

model AgencyClientLink {
  id                  String   @id @default(uuid())
  agency_user_id      String
  client_user_id      String
  role                String   @default("CLIENT_ADMIN")
  status              String   @default("ACTIVE")
  category            String?  @default("General")
  monthly_credit_cap  Int?     @default(10000)
  assigned_manager_id String?
  assigned_project_ids String[] @default([])
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  agency User @relation("AgencyClientOwner", fields: [agency_user_id], references: [id], onDelete: Cascade)
  client User @relation("AgencyClientUser", fields: [client_user_id], references: [id], onDelete: Cascade)

  @@unique([agency_user_id, client_user_id])
  @@index([client_user_id, status])
}

model AgencyBranding {
  id                 String   @id @default(uuid())
  agency_user_id     String   @unique
  brand_name         String?
  logo_url           String?
  favicon_url        String?
  primary_color      String   @default("#2563eb")
  accent_color       String   @default("#0f172a")
  portal_title       String?
  support_email      String?
  custom_cname       String?
  footer_text        String?
  enable_white_label Boolean  @default(true)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  agency User @relation(fields: [agency_user_id], references: [id], onDelete: Cascade)
}

model AgencyPortalShare {
  id             String    @id @default(uuid())
  token          String    @unique
  agency_user_id String
  project_id     String
  title          String?
  passcode_hash  String?
  is_active      Boolean   @default(true)
  expires_at     DateTime?
  view_count     Int       @default(0)
  last_viewed_at DateTime?
  allowed_tabs   String[]  @default(["OVERVIEW", "AI_VISIBILITY", "SEO_KEYWORDS", "DELIVERABLES"])
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  agency  User    @relation("AgencyPortalShares", fields: [agency_user_id], references: [id], onDelete: Cascade)
  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([token, is_active])
  @@index([agency_user_id, project_id])
}

model Project {
  id             String   @id @default(uuid())
  brand_name     String
  brand_url      String
  brand_location String
  user_id        String
  user           User     @relation(fields: [user_id], references: [id])
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  prompts                          Prompt[]
  competitors                      Competitor[]
  runs                             Run[]
  scrape_jobs                      ScrapeJob[]
  web_analytics_sites              WebAnalyticsSite[]
  sara_conversations               SaraConversation[]
  topics                           Topic[]
  ai_reports                       AIReport[]
  content_briefs                   ContentBrief[]
  action_queue_items               ActionQueueItem[]
  weekly_email_reports             WeeklyEmailReport[]
  reddit_intelligence_runs         RedditIntelligenceRun[]
  seo_audits                       SeoAudit[]
  reddit_posts                     RedditPost[]
  agency_portal_shares             AgencyPortalShare[]
  brand_preference                 BrandPreference?
  engine_preferences               ProjectEnginePreference[]
  // SEO V2
  seo_crawl_jobs                   SeoCrawlJob[]
  seo_v2_audits                    SeoV2Audit[]
  gsc_connections                  GscConnection[]
  gsc_data_rows                    GscDataRow[]
  seo_domain_overview_snapshots    SeoDomainResearchOverviewSnapshot[]
  seo_domain_keyword_snapshots     SeoDomainResearchKeywordSnapshot[]
  seo_domain_top_pages_snapshots   SeoDomainResearchTopPagesSnapshot[]
  seo_domain_competitor_snapshots  SeoDomainResearchCompetitorSnapshot[]
  seo_domain_keyword_gap_snapshots SeoDomainResearchKeywordGapSnapshot[]
  seo_provider_snapshots           SeoProviderSnapshot[]
  seo_rank_tracking_configs        SeoRankTrackingConfig[]
  seo_rank_check_runs              SeoRankCheckRun[]
  seo_onboarding_runs              SeoOnboardingRun[]
  // Campaigns
  whatsapp_account                 WhatsAppAccount?
  voice_account                    VoiceAccount?
  email_account                    EmailAccount?

  @@unique([user_id, brand_name])
  @@index([user_id, created_at])
}

model ProjectEnginePreference {
  id         String   @id @default(uuid())
  project_id String
  project    Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  engine     Engine
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([project_id, engine])
  @@index([project_id, is_active])
}

model BrandPreference {
  id                 String   @id @default(uuid())
  project_id         String   @unique
  project            Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user_id            String
  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  industry_category  String
  buyer_persona      String?
  keywords           Json     @default("[]")
  avoid_keywords     Json     @default("[]")
  competitor_context String?
  reddit_focus       Json     @default("[]")
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@index([user_id])
  @@index([project_id, user_id])
}

model RedditIntelligenceRun {
  id            String    @id @default(uuid())
  project_id    String
  project       Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user_id       String
  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  mode          String
  status        String    @default("RUNNING")
  credits_spent Int       @default(0)
  post_limit    Int       @default(25)
  keyword_count Int       @default(0)
  keywords      Json      @default("[]")
  summary       Json?
  themes        Json      @default("[]")
  actions       Json      @default("[]")
  raw_result    Json?
  error_reason  String?
  completed_at  DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  posts RedditPost[]

  @@index([project_id, user_id, created_at])
  @@index([user_id, created_at])
  @@index([status, created_at])
}

model RedditPost {
  id                    String                 @id @default(uuid())
  run_id                String?
  run                   RedditIntelligenceRun? @relation(fields: [run_id], references: [id], onDelete: SetNull)
  project_id            String
  project               Project                @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user_id               String
  user                  User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post_id               String?
  url                   String
  subreddit             String?
  title                 String
  description           String?
  author                String?
  keyword               String?
  num_comments          Int                    @default(0)
  num_upvotes           Int                    @default(0)
  date_posted           DateTime?
  sentiment             String?
  intent                String?
  importance_score      Int                    @default(0)
  mentioned_brands      Json                   @default("[]")
  mentioned_competitors Json                   @default("[]")
  raw_json              Json?
  created_at            DateTime               @default(now())
  updated_at            DateTime               @updatedAt

  @@unique([project_id, url])
  @@index([project_id, importance_score])
  @@index([project_id, subreddit])
  @@index([project_id, user_id, importance_score, num_comments])
  @@index([user_id, created_at])
}

model WeeklyEmailReport {
  id               String    @id @default(uuid())
  user_id          String
  user             User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  project_id       String
  project          Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  period_start     DateTime
  period_end       DateTime
  status           String
  pdf_filename     String?
  brevo_message_id String?
  error_reason     String?
  sent_at          DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@unique([project_id, period_start, period_end])
  @@index([user_id, created_at])
  @@index([project_id, created_at])
  @@index([status, created_at])
}

model ContentBrief {
  id                 String   @id @default(uuid())
  project_id         String
  project            Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user_id            String
  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  status             String
  title              String
  slug               String?
  topic              String?
  target_prompt_id   String?
  target_prompt_text String
  content_type       String?
  action             String?
  opportunity_offset Int      @default(0)
  brief              Json
  article            Json?
  prompt_used        Json?
  generation_error   String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@unique([project_id, user_id, target_prompt_id, opportunity_offset])
  @@index([project_id, user_id, updated_at])
  @@index([user_id, updated_at])
}

model AIReport {
  id                    String   @id
  project_id            String
  project               Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user_id               String
  user                  User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  brand_name            String
  period_type           String
  period_start          DateTime
  period_end            DateTime
  previous_period_start DateTime
  previous_period_end   DateTime
  status                String
  summary               Json?
  report                Json
  errors                Json     @default("[]")
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  @@index([project_id, created_at])
  @@index([user_id, created_at])
}

model ActionQueueItem {
  id                 String    @id @default(uuid())
  project_id         String
  project            Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user_id            String
  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title              String
  description        String
  category           String
  priority           String
  status             String    @default("OPEN")
  impact_score       Int       @default(0)
  effort_score       Int       @default(0)
  confidence_score   Int       @default(0)
  recommended_action String?
  success_metric     String?
  evidence           Json      @default("{}")
  source_type        String?
  source_ref_id      String?
  due_at             DateTime?
  completed_at       DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  @@index([project_id, user_id, status, priority])
  @@index([project_id, user_id, updated_at])
  @@index([user_id, status])
}

model Topic {
  id         String   @id @default(uuid())
  name       String
  project_id String
  project    Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([project_id, name])
  @@index([project_id])
}

model Prompt {
  id             String       @id @default(uuid())
  text           String
  topic          String
  tags           String[]     @default([])
  type           String
  project_id     String
  project        Project      @relation(fields: [project_id], references: [id])
  is_active      Boolean      @default(true)
  status         PromptStatus @default(ACTIVE)
  source         PromptSource @default(GENERATED)
  geo_enabled    Boolean      @default(false)
  priority_score Float?
  volume_score   Float?
  last_run_at    DateTime?
  created_at     DateTime     @default(now())
  updated_at     DateTime     @default(now()) @updatedAt

  chats        Chat[]
  scrape_jobs  ScrapeJob[]
  geo_variants GeoPromptVariant[]

  @@index([project_id, is_active, status])
  @@index([project_id, created_at])
}

model SeoAudit {
  id                 String   @id @default(uuid())
  project_id         String
  project            Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user_id            String
  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  url                String
  status             String   @default("COMPLETED")
  overall_score      Int      @default(0)
  technical_score    Int      @default(0)
  ai_readiness_score Int      @default(0)
  local_score        Int      @default(0)
  content_score      Int      @default(0)
  schema_score       Int      @default(0)
  credits_spent      Int      @default(0)
  error_reason       String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  pages        SeoAuditPage[]
  issues       SeoIssue[]
  actions      SeoAction[]
  rank_results SeoRankResult[]

  @@index([project_id, created_at])
  @@index([user_id, created_at])
}

model SeoRankResult {
  id              String   @id @default(uuid())
  project_id      String
  audit_id        String
  audit           SeoAudit @relation(fields: [audit_id], references: [id], onDelete: Cascade)
  keyword         String
  country         String
  language        String
  target_domain   String
  google_rank     Int?
  ranking_url     String?
  ranking_title   String?
  organic_results Json     @default("[]")
  related_queries Json     @default("[]")
  status          String   @default("COMPLETED")
  error_reason    String?
  created_at      DateTime @default(now())

  @@unique([audit_id, keyword])
  @@index([project_id, created_at])
  @@index([audit_id])
}

model SeoDomainResearchOverviewSnapshot {
  id                   String   @id @default(uuid())
  project_id           String
  project              Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  requested_by_user_id String
  requested_by_user    User     @relation(fields: [requested_by_user_id], references: [id], onDelete: Cascade)
  target_domain        String
  location_code        Int
  country_iso_code     String
  language_code        String
  history_months       Int
  payload              Json
  provider_environment String
  provider_cost_usd    Decimal  @default(0) @db.Decimal(12, 6)
  provider_task_ids    String[] @default([])
  fetched_at           DateTime @default(now())
  expires_at           DateTime

  @@index([project_id, target_domain, location_code, language_code, fetched_at])
  @@index([expires_at])
}

model SeoDomainResearchKeywordSnapshot {
  id                   String   @id @default(uuid())
  project_id           String
  project              Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  requested_by_user_id String
  requested_by_user    User     @relation(fields: [requested_by_user_id], references: [id], onDelete: Cascade)
  target_domain        String
  location_code        Int
  country_iso_code     String
  language_code        String
  item_limit           Int
  total_count          Int
  payload              Json
  provider_environment String
  provider_cost_usd    Decimal  @default(0) @db.Decimal(12, 6)
  provider_task_ids    String[] @default([])
  fetched_at           DateTime @default(now())
  expires_at           DateTime

  @@index([project_id, target_domain, location_code, language_code, fetched_at])
  @@index([expires_at])
}

model SeoDomainResearchTopPagesSnapshot {
  id                   String   @id @default(uuid())
  project_id           String
  project              Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  requested_by_user_id String
  requested_by_user    User     @relation(fields: [requested_by_user_id], references: [id], onDelete: Cascade)
  target_domain        String
  location_code        Int
  country_iso_code     String
  language_code        String
  item_limit           Int
  total_count          Int
  payload              Json
  provider_environment String
  provider_cost_usd    Decimal  @default(0) @db.Decimal(12, 6)
  provider_task_ids    String[] @default([])
  fetched_at           DateTime @default(now())
  expires_at           DateTime

  @@index([project_id, target_domain, location_code, language_code, fetched_at])
  @@index([expires_at])
}

model SeoDomainResearchCompetitorSnapshot {
  id                   String   @id @default(uuid())
  project_id           String
  project              Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  requested_by_user_id String
  requested_by_user    User     @relation(fields: [requested_by_user_id], references: [id], onDelete: Cascade)
  target_domain        String
  location_code        Int
  country_iso_code     String
  language_code        String
  item_limit           Int
  total_count          Int
  payload              Json
  provider_environment String
  provider_cost_usd    Decimal  @default(0) @db.Decimal(12, 6)
  provider_task_ids    String[] @default([])
  fetched_at           DateTime @default(now())
  expires_at           DateTime

  @@index([project_id, target_domain, location_code, language_code, fetched_at])
  @@index([expires_at])
}

model SeoDomainResearchKeywordGapSnapshot {
  id                   String   @id @default(uuid())
  project_id           String
  project              Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  requested_by_user_id String
  requested_by_user    User     @relation(fields: [requested_by_user_id], references: [id], onDelete: Cascade)
  target_domain        String
  competitor_domain    String
  location_code        Int
  country_iso_code     String
